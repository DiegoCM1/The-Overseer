# =============================================================================
# The Overseer — environment template
#
#   cp .env.example .env      then fill in the real values
#
# Every var below is read by core/config.py (pydantic-settings). Vars marked
# REQUIRED have no default: if one is missing, Settings() raises at import and
# the app will NOT boot. That is deliberate — fail loud at startup, never at
# 2 AM inside a scheduler tick.
#
# .env is gitignored. This file is committed. Never put real secrets here.
# =============================================================================


# ---- AI (OpenRouter, OpenAI-compatible endpoint) -----------------------------
# REQUIRED. Used only to write message copy. It decides nothing.
OPENROUTER_API_KEY="sk-or-..."


# ---- Runtime mode ------------------------------------------------------------
# REQUIRED. "dev" | "prod".  dev additionally exposes POST /debug/tick, which
# fires a poll immediately instead of waiting for the heartbeat.
APP_ENV="dev"


# ---- Database (Supabase Postgres) --------------------------------------------
# REQUIRED. Must be a postgresql:// URL — psycopg2-binary is the driver.
#
# Supabase exposes THREE connection strings. Use the SESSION POOLER (port 5432).
# Get it from: Supabase dashboard → Connect → "Session pooler".
#
#   DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Why the session pooler and not the other two:
#   - Transaction pooler (port 6543) does NOT support prepared statements, and
#     Alembic migrations will misbehave against it. Never point DATABASE_URL here.
#   - Direct connection (db.PROJECTREF.supabase.co:5432) is IPv6-only unless you
#     pay for the IPv4 add-on, so it fails on most home/office networks.
#   - Session pooler is IPv4-friendly and is what Supabase's own docs recommend
#     for migrations. This service is a long-running container, not serverless,
#     so session mode is the correct fit anyway.
#
# sslmode=require is not optional — Supabase refuses plaintext connections.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"


# ---- Twilio: WhatsApp --------------------------------------------------------
# All four REQUIRED. WhatsApp is the only delivery channel that works today.
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"   # Twilio sandbox number
TWILIO_WHATSAPP_TO="whatsapp:+52..."           # Diego — the one under obligation


# ---- The bet -----------------------------------------------------------------
# Daniel is the counterparty. His WhatsApp thread is an out-of-band replica of the
# history that Diego cannot rewrite, so the daily heartbeat depends on this being
# set. Leave it blank and the integrity story quietly stops working.
TWILIO_WHATSAPP_DANIEL="whatsapp:+52..."

# healthchecks.io check URL, pinged after every judgment run. If the Overseer dies,
# healthchecks notifies DANIEL directly — configure the alert to reach him, not
# Diego. Without this, a crashed server is worth 200 MXN/day to Diego.
HEALTHCHECKS_URL=""

HEARTBEAT_HOUR=20                              # local hour for Daniel's daily report

# NOTE: business-initiated WhatsApp messages need pre-approved templates.
# See docs/twilio-whatsapp-templates.md — five of them, and the sandbox is not
# sufficient for production.


# ---- life-os integration (the system of record that gets polled) -------------
# OPTIONAL. Defaults shown. LIFEOS_API_URL points at the life-os service, which
# lives in a SEPARATE repo. In prod this must be the deployed URL, not localhost.
LIFEOS_API_URL="http://localhost:8000"
LIFEOS_API_SECRET=""                           # must equal life-os SHARED_SECRET


# ---- Escalation tuning -------------------------------------------------------
# OPTIONAL. Defaults shown. Minutes past a deadline before each step fires.
POLL_MINUTES=15                                # heartbeat interval
GRACE1_MIN=60                                  # → level 2, firmer message
GRACE2_MIN=180                                 # → level 3, call-worthy
QUIET_START=22                                 # no calls placed inside
QUIET_END=8                                    #   [QUIET_START, QUIET_END)
ENABLE_CALLS=false                             # true once a voice number exists


# ---- Delivery targets for voice (E.164) --------------------------------------
# OPTIONAL. Only needed when ENABLE_CALLS=true.
MY_PHONE="+52..."                              # who gets called
TWILIO_VOICE_FROM=""                           # voice-capable number, NOT the WA sandbox
PUBLIC_BASE_URL=""                             # public URL of THIS service; Twilio
                                               #   fetches GET {PUBLIC_BASE_URL}/voice/twiml
# Currently unused: twilio_client.send_sms() exists but nothing calls it.
TWILIO_SMS_FROM=""                             # SMS-capable Twilio number


# ---- Locale ------------------------------------------------------------------
# OPTIONAL. Drives APScheduler's timezone and all deadline math.
TIMEZONE="America/Mexico_City"


# ---- Observability / debugging -----------------------------------------------
# OPTIONAL. Defaults shown.
LOG_LEVEL="INFO"          # DEBUG | INFO | WARNING | ERROR
SQL_ECHO=false            # true → log every SQL statement. Very noisy; debugging only.
DB_CONNECT_TIMEOUT=10     # seconds before an unreachable Postgres fails loudly
DB_POOL_RECYCLE=1800      # seconds; keep under the pooler's idle timeout
