# ---- AI (OpenRouter, OpenAI-compatible) ----
OPENROUTER_API_KEY="sk-or-..."

# ---- DB (Railway Postgres) ----
DATABASE_URL="postgresql://..."

# dev | prod  (dev exposes POST /debug/tick)
APP_ENV="dev"

# ---- Twilio: WhatsApp (works today via the sandbox) ----
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO="whatsapp:+52..."      # verify the MX format (52 vs 521)

# ---- life-os integration ----
LIFEOS_API_URL="http://localhost:8000"    # deployed life-os API in prod
LIFEOS_API_SECRET=""                       # = life-os SHARED_SECRET

# ---- Escalation tuning (optional; defaults shown) ----
POLL_MINUTES=15
GRACE1_MIN=60
GRACE2_MIN=180
QUIET_START=22
QUIET_END=8
ENABLE_CALLS=false                         # flip to true once a voice number is set up

# ---- Delivery targets for SMS/voice (E.164) ----
MY_PHONE="+52..."
TWILIO_SMS_FROM=""                         # SMS-capable Twilio number
TWILIO_VOICE_FROM=""                       # voice-capable Twilio number (NOT the WA sandbox)
PUBLIC_BASE_URL=""                         # public URL of THIS service (Railway), for the TwiML callback

TIMEZONE="America/Mexico_City"
